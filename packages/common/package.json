{
  "name": "@company/common",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "circular": "rev-dep circular"
  },
  "devDependencies": {
    "rev-dep": "2.4.0-beta.2"
  },
  "exports": {
    "./file-utils": {
      "types": "./dist/file-utils.d.ts",
      "node": "./dist/file-utils.js",
      "default": "./src/file-utils.ts"
    },
    "./async-utils": {
      "types": "./dist/async-utils.d.ts",
      "node": "./dist/async-utils.js",
      "default": "./src/async-utils.ts"
    }
  },
  "imports": {
    "#common/*.ts": {
      "types": "./src/*.ts",
      "node": "./dist/*.js",
      "default": "./src/*.ts"
    }
  }
}