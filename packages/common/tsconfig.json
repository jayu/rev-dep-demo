{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "allowJs": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "*": [
        "./src/*"
      ],
      "$base/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}